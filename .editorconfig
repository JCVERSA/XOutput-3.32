# Editor configuration for XOutput
root = true

[*]
insert_final_newline = true
charset = utf-8

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{xaml,csproj,props,targets}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
end_of_line = lf
