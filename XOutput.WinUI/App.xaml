<Application
    x:Class="XOutput.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:XOutput.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme-aware card brushes (Fluent card-equivalent) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#3D3D3D"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Converters (x:Bind-friendly) -->
            <conv:ValueToOpacityConverter x:Key="ValueToOpacityConverter"/>
            <conv:StickOffsetConverter x:Key="StickOffsetConverter"/>
            <conv:BoolToColorConverter x:Key="BoolToBrush"/>

            <!-- Card style: the WinUI3-native card-equivalent (Border + CornerRadius + theme brush) -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
