<ContentDialog
    x:Class="XOutput.WinUI.Dialogs.AddControllerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XOutput.WinUI.Controls"
    xmlns:xin="using:XOutput.Devices.XInput"
    Title="Add Controller"
    CloseButtonText="Cancel"
    PrimaryButtonText="Next"
    DefaultButton="Primary">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stepper header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock x:Name="StepText" FontWeight="SemiBold"/>
            <TextBlock x:Name="StepCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Step content (swapped in code-behind) -->
        <ContentControl x:Name="StepContent" Grid.Row="1"/>

        <!-- Live controller visualization (step 2) -->
        <controls:XboxControllerView x:Name="ControllerView" Grid.Row="1"
                                     Width="440" Height="250" HorizontalAlignment="Center"
                                     Visibility="Collapsed"
                                     LiveTarget="{x:Bind LiveTarget, Mode=OneWay}"
                                     LiveValue="{x:Bind LiveValue, Mode=OneWay}"
                                     Highlight="{x:Bind Highlight, Mode=OneWay}"/>
    </Grid>
</ContentDialog>
