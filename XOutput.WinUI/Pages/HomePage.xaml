<Page
    x:Class="XOutput.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XOutput.WinUI.Pages"
    xmlns:controls="using:XOutput.WinUI.Controls"
    Loaded="Page_Loaded">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title + Add Controller -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Home" Style="{ThemeResource TitleTextBlockStyle}"/>
            <Button x:Name="AddControllerButton" Content="Add Controller" HorizontalAlignment="Right" Click="AddController_Click"/>
        </Grid>

        <!-- Two-card row -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input Devices card -->
            <Border x:Name="DevicesCard" Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Input Devices" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <!-- ItemsControl: item containers get a compositor entrance
                         (fade + slide) via Loaded; ImplicitAnimations also smooth
                         any later layout-driven offset change. -->
                    <ItemsControl x:Name="DevicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Loaded="DeviceItem_Loaded" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Status dot is compositor-rendered; color
                                         changes animate via ColorKeyFrameAnimation. -->
                                    <controls:StatusDot Width="10" Height="10" VerticalAlignment="Center"
                                                        IsConnected="{Binding Connected}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Virtual Controllers card -->
            <Border x:Name="ControllersCard" Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Virtual Controllers" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="ControllersStatus" TextWrapping="Wrap"/>
                    <!-- Same entrance pattern as the device list; populated as soon
                         as controller creation is wired (next prompt). -->
                    <ItemsControl x:Name="ControllersList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Loaded="ControllerItem_Loaded">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <StackPanel x:Name="StatusBar" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Border Style="{StaticResource CardStyle}" Padding="12,6">
                <TextBlock x:Name="DeviceCountText"/>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="12,6">
                <TextBlock x:Name="ControllerCountText"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
