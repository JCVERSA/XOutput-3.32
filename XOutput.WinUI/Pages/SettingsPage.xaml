<Page
    x:Class="XOutput.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}"/>

            <!-- General card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="General" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Name="CloseToTraySwitch" Header="Close to tray" OnContent="On" OffContent="Off"
                                  Toggled="CloseToTray_Toggled"/>
                    <ToggleSwitch x:Name="ShowAllSwitch" Header="Show all devices" OnContent="On" OffContent="Off"
                                  Toggled="ShowAll_Toggled"/>
                </StackPanel>
            </Border>

            <!-- System card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="System" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Name="HidGuardianSwitch" Header="HidGuardian setup during startup" OnContent="On" OffContent="Off"
                                  Toggled="HidGuardian_Toggled"/>
                    <ToggleSwitch x:Name="DisableRefreshSwitch" Header="Disable automatic device status detection" OnContent="On" OffContent="Off"
                                  Toggled="DisableRefresh_Toggled"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
