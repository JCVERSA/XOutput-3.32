<UserControl x:Class="XOutput.UI.Component.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XOutput.UI.Component"
             d:DataContext="{d:DesignInstance Type=local:ControllerViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d" 
             d:DesignHeight="52" d:DesignWidth="300">
    <Border Background="{Binding Model.Background}" CornerRadius="8" Padding="12,8" Margin="0,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- name + status pill -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding Model.DisplayName}" Style="{StaticResource TextBodyBase}" TextTrimming="CharacterEllipsis"/>
                <Border CornerRadius="9999" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Model.Started}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrushNavActiveBackground}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Model.StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextLabelCaps}">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.Started}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
            <!-- remove -->
            <Button Grid.Column="1" Margin="4,0" Padding="10,6" Click="RemoveClick"
                    IsEnabled="{Binding Model.Started, Converter={StaticResource BoolInverterConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRemove}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='RemoveController'}"/>
                </StackPanel>
            </Button>
            <!-- edit -->
            <Button Grid.Column="2" Margin="4,0" Padding="10,6" Click="OpenClick"
                    IsEnabled="{Binding Model.Started, Converter={StaticResource BoolInverterConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconEdit}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='Edit'}"/>
                </StackPanel>
            </Button>
            <!-- start / stop -->
            <Button Grid.Column="3" Margin="4,0,0,0" Padding="10,6" Click="ButtonClick"
                    IsEnabled="{Binding Model.CanStart}">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="ActionIcon"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconStart}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.ButtonText}" Value="Stop">
                                        <Setter Property="Data" Value="{StaticResource IconStop}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource DynamicLanguageConverter}">
                                <Binding Path="LanguageModel.Data"/>
                                <Binding Path="Model.ButtonText"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
