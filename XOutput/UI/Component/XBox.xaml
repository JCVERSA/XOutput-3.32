C 115,55 85,70 62,100
C 40,130 38,168 52,192
C 58,204 76,210 94,208
C 114,206 130,192 140,172
L 148,166
C 162,192 190,202 220,202
C 250,202 278,192 292,166
L 300,172
C 310,192 326,206 346,208
C 364,210 382,204 388,192
C 402,168 400,130 378,100
C 355,70 325,55 290,55
