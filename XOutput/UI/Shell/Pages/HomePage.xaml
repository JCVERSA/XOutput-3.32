<UserControl x:Class="XOutput.UI.Shell.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XOutput.UI.Windows"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="700">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Top bar: page title + Add Controller ===== -->
        <DockPanel Grid.Row="0" Margin="4,0,0,12">
            <Button DockPanel.Dock="Right" Padding="18,10" Click="AddControllerClick">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconAdd}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='AddController'}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='HomeMenu'}"
                       Style="{StaticResource TextHeadlineMd}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ===== Two-column cards ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input Devices card -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceContainer}"
                    BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusDefault}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="{StaticResource BrushSecondaryContainer}"
                                CornerRadius="9999" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="DirectInput" Style="{StaticResource TextLabelCaps}" FontSize="10"
                                       Foreground="{StaticResource BrushOnSurface}"/>
                        </Border>
                        <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='InputDevices'}"
                                   Style="{StaticResource TextTitleSm}"/>
                    </DockPanel>

                    <!-- empty state (brief, during startup) -->
                    <StackPanel DockPanel.Dock="Top" VerticalAlignment="Center" Margin="0,24"
                                Visibility="{Binding Model.Inputs, Converter={StaticResource EnumerableCountToVisibilityConverter}, ConverterParameter=0}">
                        <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='NoDevices'}"
                                   Style="{StaticResource TextBodyBase}" Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- device list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Model.Inputs}" Focusable="False"/>
                    </ScrollViewer>

                    <!-- show-all + force refresh -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <CheckBox IsChecked="{Binding Model.AllDevices}" Checked="CheckBoxChecked" Unchecked="CheckBoxChecked"
                                  Content="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='ShowAllDevices'}"/>
                        <Button Click="RefreshClick" Margin="0,10,0,0" Padding="16,8" HorizontalAlignment="Left"
                                Style="{StaticResource ButtonSecondaryStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='ForceRefresh'}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Virtual Controllers card -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurfaceContainer}"
                    BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusDefault}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="{StaticResource BrushSecondaryContainer}"
                                CornerRadius="9999" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="ViGEm" Style="{StaticResource TextLabelCaps}" FontSize="10"
                                       Foreground="{StaticResource BrushOnSurface}"/>
                        </Border>
                        <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='VirtualControllers'}"
                                   Style="{StaticResource TextTitleSm}"/>
                    </DockPanel>

                    <!-- empty state -->
                    <StackPanel DockPanel.Dock="Top" VerticalAlignment="Center" Margin="0,32"
                                Visibility="{Binding Model.Controllers, Converter={StaticResource EnumerableCountToVisibilityConverter}, ConverterParameter=0}">
                        <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='NoVirtualControllers'}"
                                   Style="{StaticResource TextBodyBase}" Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- controller list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Model.Controllers}" Focusable="False"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Status bar pills ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,12,4,0">
            <Border Background="{StaticResource BrushSurfaceContainer}" BorderBrush="{StaticResource BrushOutlineVariant}"
                    BorderThickness="1" CornerRadius="9999" Padding="12,4" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='ActiveDevices'}"
                               Style="{StaticResource TextBodySm}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.InputCount}" Style="{StaticResource TextDataMono}" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushSurfaceContainer}" BorderBrush="{StaticResource BrushOutlineVariant}"
                    BorderThickness="1" CornerRadius="9999" Padding="12,4" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='ActiveControllers'}"
                               Style="{StaticResource TextBodySm}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.ControllerCount}" Style="{StaticResource TextDataMono}" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushSurfaceContainer}" BorderBrush="{StaticResource BrushOutlineVariant}"
                    BorderThickness="1" CornerRadius="9999" Padding="12,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='Backend'}"
                               Style="{StaticResource TextBodySm}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.BackendName}" Style="{StaticResource TextDataMono}" FontSize="11"
                               Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
