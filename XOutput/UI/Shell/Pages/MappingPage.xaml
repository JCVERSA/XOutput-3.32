<UserControl x:Class="XOutput.UI.Shell.Pages.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:XOutput.UI.Shell.Pages"
             xmlns:Components="clr-namespace:XOutput.UI.Component"
             xmlns:xin="clr-namespace:XOutput.Devices.XInput;assembly=XOutput.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=shell:MappingPageViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="700"
             Loaded="WindowLoaded" Unloaded="WindowUnloaded">

    <UserControl.Resources>
        <!-- Device tab content -->
        <DataTemplate DataType="{x:Type shell:MappingDeviceTab}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Physical inputs -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceContainerLow}"
                        BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusDefault}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='PhysicalInputs'}"
                                   Style="{StaticResource TextTitleSm}" Margin="2,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <!-- Axes / sliders -->
                                <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='Axes'}"
                                           Style="{StaticResource TextLabelCaps}" Margin="2,4,0,4"
                                           Visibility="{Binding Axes, Converter={StaticResource EnumerableNotEmptyToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding Axes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Grid.Column="0" Content="{Binding}" Focusable="False"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Style="{StaticResource TextDataMono}" FontSize="10"
                                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                                           Text="{Binding ViewModel.Model.Type, Converter={StaticResource SourceToMappedTargetConverter}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Buttons -->
                                <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='Buttons'}"
                                           Style="{StaticResource TextLabelCaps}" Margin="2,8,0,4"
                                           Visibility="{Binding Buttons, Converter={StaticResource EnumerableNotEmptyToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Grid.Column="0" Content="{Binding}" Focusable="False"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Style="{StaticResource TextDataMono}" FontSize="10"
                                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                                           Text="{Binding ViewModel.Model.Type, Converter={StaticResource SourceToMappedTargetConverter}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- DPad -->
                                <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='DPad'}"
                                           Style="{StaticResource TextLabelCaps}" Margin="2,8,0,4"
                                           Visibility="{Binding DPads, Converter={StaticResource EnumerableNotEmptyToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding DPads}" Focusable="False"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Configure + device extras -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>

                            <!-- Configure card -->
                            <Border Background="{StaticResource BrushSurfaceContainer}"
                                    BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusDefault}" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                        <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='ConfigureInput'}"
                                                   Style="{StaticResource TextTitleSm}"/>
                                        <TextBlock Text="{Binding DataContext.SelectedSource.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   Style="{StaticResource TextDataMono}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <!-- no controller hint -->
                                    <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='NoControllerForMapping'}"
                                               Style="{StaticResource TextBodySm}" TextWrapping="Wrap" Margin="2,4,2,8"
                                               Visibility="{Binding DataContext.HasController, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={StaticResource True}}"/>

                                    <!-- input selector -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='SelectedValue'}"
                                                   Style="{StaticResource TextBodySm}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1" Height="26" ItemsSource="{Binding DataContext.Sources, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  SelectedItem="{Binding DataContext.SelectedSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" DisplayMemberPath="DisplayName"/>
                                    </Grid>

                                    <!-- target dropdown -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='Target'}"
                                                   Style="{StaticResource TextBodySm}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1" Height="26"
                                                  ItemsSource="{Binding DataContext.Targets, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  SelectedItem="{Binding DataContext.SelectedTarget, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  IsEnabled="{Binding DataContext.HasController, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource DynamicLanguageConverter}">
                                                                <Binding Path="DataContext.LanguageModel.Data" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- unmapped hint -->
                                    <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='NoMappedTargets'}"
                                               Style="{StaticResource TextBodySm}" Foreground="{StaticResource BrushOnSurfaceVariant}"
                                               Margin="2,6,2,2"
                                               Visibility="{Binding DataContext.HasMapping, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={StaticResource True}}"/>

                                    <!-- deadzone -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='Deadzone'}"
                                                   Style="{StaticResource TextBodySm}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="50"
                                                Value="{Binding DataContext.DeadzonePercent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                                IsEnabled="{Binding DataContext.HasMapping, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <TextBlock Grid.Column="2" Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Style="{StaticResource TextDataMono}" FontSize="11"
                                                   Text="{Binding DataContext.DeadzonePercent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, StringFormat={}{0:0}%}"/>
                                    </Grid>

                                    <!-- invert -->
                                    <CheckBox Margin="2,6" Content="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='Invert'}"
                                              IsChecked="{Binding DataContext.Invert, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.HasMapping, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

                                    <!-- live preview -->
                                    <Border Background="{StaticResource BrushSurfaceContainerLow}" BorderBrush="{StaticResource BrushOutlineVariant}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='LivePreview'}"
                                                       Style="{StaticResource TextLabelCaps}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='RawValue'}"
                                                               Style="{StaticResource TextBodySm}"/>
                                                    <TextBlock Text="{Binding DataContext.RawValue, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, StringFormat={}{0:0.000}}"
                                                               Style="{StaticResource TextDataMono}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='MappedValue'}"
                                                               Style="{StaticResource TextBodySm}"/>
                                                    <TextBlock Text="{Binding DataContext.MappedValue, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, StringFormat={}{0:0.000}}"
                                                               Style="{StaticResource TextDataMono}"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- fill bar -->
                                            <Grid Height="8" Margin="0,10,0,0">
                                                <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="4"/>
                                                <Border Background="{StaticResource BrushPrimary}" CornerRadius="4" HorizontalAlignment="Stretch">
                                                    <Border.RenderTransformOrigin>0,0</Border.RenderTransformOrigin>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform>
                                                            <ScaleTransform.ScaleX>
                                                                <Binding Path="DataContext.MappedValue" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                            </ScaleTransform.ScaleX>
                                                        </ScaleTransform>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <!-- 2D indicator (axes only) -->
                                            <Canvas Width="48" Height="48" Margin="0,10,0,0" HorizontalAlignment="Center"
                                                    Visibility="{Binding DataContext.SelectedSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource SourceIsAxisToVisibilityConverter}}">
                                                <Border Width="48" Height="48" BorderBrush="{StaticResource BrushOutlineVariant}"
                                                        BorderThickness="1" CornerRadius="4" Background="{StaticResource BrushSurfaceContainer}">
                                                    <Grid Width="48" Height="48">
                                                        <Path Data="M 24,0 L 24,48 M 0,24 L 48,24" Stroke="{StaticResource BrushOutlineVariant}" StrokeThickness="0.5"/>
                                                    </Grid>
                                                </Border>
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushPrimary}"
                                                         Canvas.Left="{Binding DataContext.RawValue, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource RatioToPositionConverter}}"
                                                         Canvas.Top="{Binding DataContext.RawValue, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource RatioToPositionConverter}}"/>
                                            </Canvas>
                                            <!-- live controller visualization -->
                                            <Components:XBox Width="280" Height="160" Margin="0,10,0,0" HorizontalAlignment="Center"
                                                             XInputType="{Binding DataContext.SelectedTarget, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, TargetNullValue={x:Static xin:XInputTypes.A}}"
                                                             Highlight="{Binding DataContext.HasMapping, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                             LiveTarget="{Binding DataContext.SelectedTarget, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, TargetNullValue={x:Static xin:XInputTypes.A}}"
                                                             LiveValue="{Binding DataContext.RawValue, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                             Visibility="{Binding DataContext.HasMapping, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Force feedback + HidGuardian (unchanged functionality) -->
                            <Border Background="{StaticResource BrushSurfaceContainer}"
                                    BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusDefault}" Padding="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='ForceFeedback'}"
                                               Style="{StaticResource TextTitleSm}" Margin="2,0,0,8"/>
                                    <TextBlock Style="{StaticResource TextBodySm}" TextWrapping="Wrap"
                                               Visibility="{Binding ViewModel.Model.ForceFeedbackAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={StaticResource True}}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource DynamicLanguageConverter}">
                                                <Binding Path="ViewModel.LanguageModel.Data"/>
                                                <Binding Path="ViewModel.Model.ForceFeedbackText"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Vertical" Visibility="{Binding ViewModel.Model.ForceFeedbackAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <CheckBox Margin="0,4" Content="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='ForceFeedback'}"
                                                  IsEnabled="{Binding ViewModel.Model.ForceFeedbackAvailable}" IsChecked="{Binding ViewModel.Model.ForceFeedbackEnabled}"
                                                  Checked="ForceFeedbackCheckBoxChecked" Unchecked="ForceFeedbackCheckBoxChecked"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='Test'}"
                                                       Style="{StaticResource TextBodySm}" VerticalAlignment="Center"/>
                                            <Button Click="ForceFeedbackButtonClick" Margin="8,0,0,0" Padding="14,6">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource AllConverter}">
                                                        <Binding Path="ViewModel.Model.ForceFeedbackEnabled"/>
                                                        <Binding Path="ViewModel.Model.ForceFeedbackAvailable"/>
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource DynamicLanguageConverter}">
                                                            <Binding Path="LanguageModel.Data"/>
                                                            <Binding Path="ViewModel.Model.TestButtonText"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding ViewModel.Model.IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Height="30" Margin="0,4" Click="AddHidGuardianButtonClick" Content="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='HidGuardianAdd'}"
                                                Visibility="{Binding ViewModel.Model.HidGuardianAdded, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={StaticResource True}}"/>
                                        <Button Height="30" Margin="0,4" Click="RemoveHidGuardianButtonClick" Content="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='HidGuardianRemove'}"
                                                Visibility="{Binding ViewModel.Model.HidGuardianAdded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Virtual Gamepad tab content -->
        <DataTemplate DataType="{x:Type shell:VirtualGamepadTab}">
            <Border Background="{StaticResource BrushSurfaceContainer}" BorderBrush="{StaticResource BrushOutlineVariant}"
                    BorderThickness="1" CornerRadius="{StaticResource CornerRadiusDefault}" Padding="24"
                    VerticalAlignment="Top" Margin="4">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitleSm}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DataContext.LanguageModel.Data, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource LanguageConverter}, ConverterParameter='VirtualGamepadInfo'}"
                               Style="{StaticResource TextBodyBase}" TextWrapping="Wrap" Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <TextBlock Grid.Row="0" Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='Mapping'}"
                   Style="{StaticResource TextHeadlineMd}" Margin="4,0,0,12"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" DisplayMemberPath="Title"/>

        <!-- Bottom action row -->
        <DockPanel Grid.Row="2" Margin="4,12,4,0">
            <Button DockPanel.Dock="Right" Padding="18,10" Click="SaveMappingClick">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSave}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='SaveMapping'}"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Margin="0,0,10,0" Padding="18,10" Style="{StaticResource ButtonSecondaryStyle}"
                    Click="ExportProfileClick" IsEnabled="{Binding HasController}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconExport}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LanguageModel.Data, Converter={StaticResource LanguageConverter}, ConverterParameter='ExportProfile'}"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
