<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Kinetic Console — icon set
         Method: vector Path-based icons, drawn as vertical 2 px-stroke
         WPF Paths in a 20x20 coordinate space (round caps/joins).
         Chosen over an icon font/SVG package because:
           - zero external dependency / no NuGet + no font embedding,
           - identical rendering approach to the shell sidebar (already
             Path-based), keeping ONE consistent method app-wide,
           - fully offline-safe (no license or CDN concerns).
         Consumers render them at 16-20 px via Stretch=Uniform and bind
         the stroke color to the surrounding foreground.
         ================================================================ -->

    <!-- Navigation / pages -->
    <Geometry x:Key="IconHome">M 4,10 L 10,4 L 16,10 M 6,9 L 6,16 L 14,16 L 14,9</Geometry>
    <Geometry x:Key="IconControllerTest">M 4,8 C 4,6.9 4.9,6 6,6 L 14,6 C 15.1,6 16,6.9 16,8 L 16,12 C 16,13.1 15.1,14 14,14 L 6,14 C 4.9,14 4,13.1 4,12 Z M 7,9 L 7,11 M 6,10 L 8,10 M 13,9.5 L 13,11.5 M 12.25,10.5 L 13.75,10.5</Geometry>
    <Geometry x:Key="IconMapping">M 3,6 L 15,6 M 18,6 L 20,6 M 15,4 L 15,8 M 3,12 L 7,12 M 10,12 L 20,12 M 7,10 L 7,14 M 3,18 L 16,18 M 19,18 L 20,18 M 16,16 L 16,20</Geometry>
    <Geometry x:Key="IconDiagnostics">M 2,10 L 6,10 L 9,3 L 13,17 L 16,10 L 20,10</Geometry>
    <Geometry x:Key="IconSettings">M 10,6.8 A 3.2,3.2 0 1 1 10,6.79 M 10,2.5 L 10,5 M 10,15 L 10,17.5 M 2.5,10 L 5,10 M 15,10 L 17.5,10 M 4.7,4.7 L 6.5,6.5 M 13.5,13.5 L 15.3,15.3 M 4.7,15.3 L 6.5,13.5 M 13.5,6.5 L 15.3,4.7</Geometry>

    <!-- Card / row actions -->
