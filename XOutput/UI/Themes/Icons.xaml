    <Geometry x:Key="IconRefresh">M 16,10 A 6,6 0 1 1 14.3,5.6 M 16,3.5 L 16,7 L 12.5,7</Geometry>
    <Geometry x:Key="IconExport">M 3,13 L 3,15 L 17,15 L 17,13 M 10,13 L 10,4 M 6,8 L 10,4 L 14,8</Geometry>
    <Geometry x:Key="IconSave">M 3,3 L 13,3 L 17,7 L 17,17 L 3,17 Z M 13,3 L 13,8 L 6,8 L 6,3 M 6,17 L 6,12 L 14,12 L 14,17</Geometry>

    <!-- Console drawer -->
