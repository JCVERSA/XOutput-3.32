    <Geometry x:Key="IconRemove">M 3,5 L 17,5 M 5,5 L 5,18 L 15,18 L 15,5 M 8,8 L 8,15 M 12,8 L 12,15 M 7,3 L 13,3 L 13,5 L 7,5</Geometry>
    <Geometry x:Key="IconStart">M 5,3 L 17,10 L 5,17 Z</Geometry>
    <Geometry x:Key="IconStop">M 5,5 L 15,5 L 15,15 L 5,15 Z</Geometry>
    <Geometry x:Key="IconConfigure">M 10,6.8 A 3.2,3.2 0 1 1 10,6.79 M 10,2.5 L 10,5 M 10,15 L 10,17.5 M 2.5,10 L 5,10 M 15,10 L 17.5,10 M 4.7,4.7 L 6.5,6.5 M 13.5,13.5 L 15.3,15.3 M 4.7,15.3 L 6.5,13.5 M 13.5,6.5 L 15.3,4.7</Geometry>
