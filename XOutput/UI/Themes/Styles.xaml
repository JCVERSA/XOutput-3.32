<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Kinetic Console — implicit control styles
         All styles are TargetType only (no x:Key) so every standard WPF
         control picks up the theme automatically.
         ================================================================ -->

    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <!-- Kept at the WPF default (12) so existing fixed-width controls keep their
             pre-theme text metrics; the 14 px body scale lives in the named text
             styles (TextBodyBase et al.) for the layout step in Prompt 3. -->
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushOnSurface}"/>
        <!-- Crisp small text; grayscale AA avoids ClearType fringing on dark surfaces. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- Button (primary) -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushPrimaryContainer}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnPrimaryContainer}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Horizontal padding per design token. Vertical 6 (not 10): several existing
             buttons are fixed at Height=30, where 10 px vertical padding would leave
             less than the 12 px line height and clip localized labels vertically. -->
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            SnapsToDevicePixels="True"/>
                    <!-- Content is a sibling of the rounded border (not clipped by it) so
                         long localized strings (e.g. German) stay fully visible, matching
                         the pre-theme behavior on fixed-width buttons. -->
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                    <Rectangle x:Name="FocusRing" RadiusX="8" RadiusY="8" Stroke="{StaticResource BrushPrimary}"
                               StrokeThickness="2" Margin="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPrimaryContainerHover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPrimaryContainerPressed}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerLow}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushOutline}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- PasswordBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerLow}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="PasswordBox">
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        SnapsToDevicePixels="True">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushOutline}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerLow}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="MaxDropDownHeight" Value="240"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ComboBox">
                <Grid SnapsToDevicePixels="True">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadiusSmall}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                     Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="True"
                                     Background="Transparent" BorderThickness="0" Style="{x:Null}"/>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="1" Width="24" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 8,0 Z"
                                                  Fill="{StaticResource BrushOnSurfaceVariant}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrushPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                           VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border x:Name="DropDownBorder" Background="{StaticResource BrushSurfaceContainer}"
                                BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusSmall}" Padding="4"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="{StaticResource ColorShadow}"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="True">
                        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                    <Trigger Property="IsDropDownOpen" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1"
                        SnapsToDevicePixels="True">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPrimaryContainer}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushOnPrimaryContainer}"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                            Background="{StaticResource BrushSurfaceContainerLow}"
                            BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Path x:Name="CheckMark" Data="M 3,9.5 L 7,13 L 15,5"
                              Stroke="{StaticResource BrushOnPrimaryContainer}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushPrimaryContainer}"/>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPrimaryContainer}"/>
                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse x:Name="Outer" Fill="{StaticResource BrushSurfaceContainerLow}"
                                 Stroke="{StaticResource BrushOutlineVariant}" StrokeThickness="1"/>
                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource BrushOnPrimaryContainer}"
                                 Visibility="Collapsed"/>
                    </Grid>
                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Outer" Property="Fill" Value="{StaticResource BrushPrimaryContainer}"/>
                        <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BrushPrimaryContainer}"/>
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BrushPrimary}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Outer" Property="Opacity" Value="0.6"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ScrollBar (thin) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" VerticalAlignment="Stretch">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" IsTabStop="False"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" IsTabStop="False"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbBd" Background="{StaticResource BrushOutlineVariant}"
                                                CornerRadius="4" Margin="2"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushOutline}"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" HorizontalAlignment="Stretch">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Background="{StaticResource BrushOutlineVariant}"
                                                        CornerRadius="4" Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushOutline}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource BrushPrimary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ProgressBar">
                <Grid SnapsToDevicePixels="True">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" VerticalAlignment="Bottom"/>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GridSplitter -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
        <Setter Property="ShowsPreview" Value="False"/>
    </Style>

    <!-- Slider -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="DecreaseFill" Background="{StaticResource BrushPrimary}"
                                                CornerRadius="3" Height="6"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="IncreaseFill" Background="{StaticResource BrushSurfaceContainerHigh}"
                                                CornerRadius="3" Height="6"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse x:Name="ThumbCircle" Width="16" Height="16"
                                                 Fill="{StaticResource BrushPrimaryContainer}"
                                                 Stroke="{StaticResource BrushPrimary}" StrokeThickness="2"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThumbCircle" Property="Fill" Value="{StaticResource BrushPrimaryContainerHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ThumbCircle" Property="Fill" Value="{StaticResource BrushPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" HorizontalAlignment="Center" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource BrushPrimary}" CornerRadius="3" Width="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource BrushSurfaceContainerHigh}" CornerRadius="3" Width="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbCircle" Width="16" Height="16"
                                                         Fill="{StaticResource BrushPrimaryContainer}"
                                                         Stroke="{StaticResource BrushPrimary}" StrokeThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Fill" Value="{StaticResource BrushPrimaryContainerHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Fill" Value="{StaticResource BrushPrimary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TabControl / TabItem -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="TabControl">
                <Grid KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                              Margin="0,0,0,8" KeyboardNavigation.TabIndex="1"
                              Panel.ZIndex="1"/>
                    <Border Grid.Row="1" Background="{StaticResource BrushSurfaceContainer}"
                            BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusDefault}" Padding="12">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="TabItem">
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"
                        SnapsToDevicePixels="True">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPrimaryContainer}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushOnPrimaryContainer}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ListBox / ListBoxItem (dark rows) -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1"
                        SnapsToDevicePixels="True">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushNavActiveBackground}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Button secondary (keyed) -->
    <Style x:Key="ButtonSecondaryStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHighest}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerLow}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Menu (MainWindow places it in a fixed 20 px row, so the bar stays compact) -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Menu">
                <Border Background="{TemplateBinding Background}" Padding="4,0" SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- MenuItem -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="MenuItem">
                <Grid SnapsToDevicePixels="True">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.ColumnSpan="2" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 0,8 Z"
                                  Fill="{StaticResource BrushOnSurfaceVariant}" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-4"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="{StaticResource BrushSurfaceContainer}"
                                BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusSmall}" Padding="4" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="{StaticResource ColorShadow}"/>
                            </Border.Effect>
                            <ItemsPresenter IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <!-- Top-level items stay compact so the fixed 20 px menu row in
                         MainWindow does not clip them (submenu items keep 12,6). -->
                    <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                        <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-2"/>
                        <Setter Property="Padding" Value="12,1"/>
                    </Trigger>
                    <Trigger Property="Role" Value="TopLevelItem">
                        <Setter Property="Padding" Value="12,1"/>
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuHeader">
                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource BrushOutline}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ContextMenu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusSmall}" Padding="4"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="{StaticResource ColorShadow}"/>
                    </Border.Effect>
                    <ItemsPresenter/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Separator -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Separator">
                <Border Height="1" Margin="8,4" Background="{TemplateBinding Background}"/>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- GroupBox (temporary: bordered card; replaced by Card in Prompt 3/4) -->
    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainer}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="GroupBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusDefault}"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,8"
                                          TextElement.FontWeight="SemiBold" TextElement.FontSize="16"
                                          TextElement.Foreground="{StaticResource BrushOnSurface}"/>
                        <ContentPresenter ContentSource="Content"/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushOutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource CornerRadiusSmall}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</ResourceDictionary>
