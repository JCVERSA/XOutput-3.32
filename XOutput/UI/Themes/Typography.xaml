<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Kinetic Console — Design tokens: typography
         Embedded fonts:
           Inter (Regular 400 / SemiBold 600 / Bold 700)
           JetBrains Mono (Medium 500)
         Runtime fallback: each FontFamily resource is a composite family —
         if the embedded pack URI font cannot be resolved, WPF falls back to
         the next available family (Segoe UI for Inter, Consolas for
         JetBrains Mono) instead of silently defaulting.
         Manual verification (Windows): temporarily rename
         Resources\Fonts\Inter\Inter Regular.ttf, rebuild, and confirm the
         UI renders in Segoe UI (repeat for JetBrains Mono / Consolas).
         ================================================================ -->

    <FontFamily x:Key="FontInter">pack://application:,,,/Resources/Fonts/Inter/#Inter, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="FontJetBrainsMono">pack://application:,,,/Resources/Fonts/JetBrainsMono/#JetBrains Mono, Consolas, Lucida Console</FontFamily>

    <!-- Named text styles -->

    <!-- Page titles -->
    <Style x:Key="TextDisplayLg" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Section headers -->
    <Style x:Key="TextHeadlineMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Card titles -->
    <Style x:Key="TextTitleSm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Body text -->
    <Style x:Key="TextBodyBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Secondary text -->
    <Style x:Key="TextBodySm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Technical values, logs -->
    <Style x:Key="TextDataMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontJetBrainsMono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Section labels.
         Note: WPF has no XAML level uppercase transform; text shown with this
         style is expected to be supplied in uppercase (e.g. via translation
         strings) — the style supplies size/weight/tracking. -->
    <Style x:Key="TextLabelCaps" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="50"/>
        <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

</ResourceDictionary>
