<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows building net9.0-windows from non-Windows hosts (CI). No effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <RootNamespace>XOutput</RootNamespace>
    <AssemblyName>XOutput</AssemblyName>
    <Authors>Ármin Csutorás</Authors>
    <Product>XOutput</Product>
    <PackageId>XOutput</PackageId>
    <NeutralLanguage>en</NeutralLanguage>
    <Description></Description>
    <Copyright>Copyright 2019</Copyright>
    <PackageLicenseUrl>https://opensource.org/licenses/MIT</PackageLicenseUrl>
    <PackageProjectUrl>https://github.com/csutorasa/XOutput</PackageProjectUrl>
    <!--<PackageIconUrl>Icon URL</PackageIconUrl>-->
    <RepositoryUrl>https://github.com/csutorasa/XOutput</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF-only dependency (tray icon). Business-logic packages live in XOutput.Core. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared business logic (Devices/Diagnostics/Tools/UpdateChecker/Logging/Languages). -->
    <ProjectReference Include="..\XOutput.Core\XOutput.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kinetic Console embedded fonts (Inter + JetBrains Mono) -->
    <Resource Include="Resources\Fonts\Inter\Inter-Regular.ttf" />
    <Resource Include="Resources\Fonts\Inter\Inter-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\Inter\Inter-Bold.ttf" />
    <Resource Include="Resources\Fonts\Inter\LICENSE.txt" />
    <Resource Include="Resources\Fonts\JetBrainsMono\JetBrainsMono-Medium.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono\OFL.txt" />
  </ItemGroup>

</Project>
